# Which LLM answers chat turns: "anthropic" (default — what this project is
# tuned for) or "nvidia" (free-tier open models via NVIDIA NIM). See the
# matching block below for whichever provider you pick.
LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Main agent model (Claude Messages API model id)
AGENT_MODEL=claude-sonnet-4-6

# --- NVIDIA NIM (used when LLM_PROVIDER=nvidia) ---
# Free API key: sign in at https://build.nvidia.com -> API Keys -> Generate.
# Check the current model catalog there too -- free-tier model availability
# changes over time, so NVIDIA_MODEL below may need updating.
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# 8B, not NVIDIA's largest model, for lower latency on the free tier -- every
# turn is at most one LLM call, so model speed is turn speed. Trade some
# quality for a 70B model (e.g. meta/llama-3.1-70b-instruct) if you'd rather.
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# SQLite file (swap for a Postgres URL in production, e.g. postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./support_agent.db

# Where the Chroma vector DB persists its data
CHROMA_DIR=./chroma_data

# Folder scanned for markdown/txt knowledge base docs
KNOWLEDGE_BASE_DIR=./knowledge_base

# Below this similarity score, retrieval is treated as "no relevant knowledge found"
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
